flowchart TD
  SCHED([Scheduled start<br/>runs on a timer]):::term
  LOCK{Previous run<br/>finished?}:::dec
  WEAR{Enough time since<br/>last stress run?}:::dec
  SKIP([Skip this run<br/>log and wait]):::term
  CFG[Load settings<br/>fixed power mode + fan mode,<br/>read trip points from device]:::proc
  ARM[Turn on auto-shutoff<br/>independent watchdog]:::proc
  SENS[Check all sensors work]:::proc
  SOK{All sensors<br/>working?}:::dec
  AMB[Measure room temp + humidity<br/>compute dew point]:::proc
  DEW{Board above<br/>dew point + 2°C?}:::dec
  ENVREF([Run refused<br/>condensation risk - environment,<br/>not a board fault]):::warn
  LIMITS[Compute ΔT safe bands for this room<br/>tag run if outside 15-35°C window]:::proc
  IDLE{Idle ΔT within<br/>calibrated band?}:::dec
  COMB[[Stress block: COMBINED<br/>see block chart]]:::macro
  CPASS{Combined<br/>passed?}:::dec
  SWEEPDUE{Full sweep<br/>due?}:::dec
  SWEEP[[Diagnostic sweep: CPU, GPU,<br/>mem-CPU, mem-GPU, log and continue]]:::macro
  MAP[Build fault map<br/>localise the problem]:::proc
  DISARM[Turn off auto-shutoff]:::proc
  FP[Compare to golden fingerprint<br/>active after 5 calibration runs]:::proc
  VERDICT{Verdict?<br/>two layers}:::dec
  REPORT[Write report: PASS<br/>graphs + metadata]:::proc
  WREPORT[Write report: WARN<br/>flag metric, alert only after<br/>2 consecutive WARNs]:::warn
  FAULT[Stop test safely<br/>note stage + cause]:::abort
  DISARM2[Turn off auto-shutoff]:::proc
  FREPORT[Write report: FAIL<br/>localise cause + send alert]:::abort
  COMMIT[Save everything<br/>script, config, results, git]:::proc
  TREND[Add to history<br/>+ run trend rules 7-run / 5-run]:::proc
  ENDW([Wait for next<br/>scheduled run]):::term

  SCHED --> LOCK
  LOCK -->|No| SKIP
  LOCK -->|Yes| WEAR
  WEAR -->|No, too soon - wear guard| SKIP
  WEAR -->|Yes| CFG
  SKIP --> ENDW
  CFG --> ARM --> SENS --> SOK
  SOK -->|No| FAULT
  SOK -->|Yes| AMB --> DEW
  DEW -->|No| ENVREF --> ENDW
  DEW -->|Yes| LIMITS --> IDLE
  IDLE -->|No, cooling problem| FAULT
  IDLE -->|Yes| COMB --> CPASS
  CPASS -->|Yes| SWEEPDUE
  CPASS -->|No| SWEEP
  SWEEPDUE -->|No| DISARM
  SWEEPDUE -->|Yes, periodic| SWEEP
  SWEEP --> MAP --> DISARM
  DISARM --> FP --> VERDICT
  VERDICT -->|PASS| REPORT --> COMMIT
  VERDICT -->|WARN 2-3σ or trend| WREPORT --> COMMIT
  VERDICT -->|FAIL| FREPORT
  FAULT --> DISARM2 --> FREPORT
  FREPORT --> COMMIT
  COMMIT --> TREND --> ENDW --> SCHED

  classDef proc fill:#E1F5EE,stroke:#0F6E56,color:#04342C;
  classDef dec fill:#E6F1FB,stroke:#185FA5,color:#042C53;
  classDef abort fill:#FAECE7,stroke:#993C1D,color:#4A1B0C;
  classDef term fill:#F1EFE8,stroke:#5F5E5A,color:#2C2C2A;
  classDef macro fill:#EEEDFE,stroke:#534AB7,color:#26215C;
  classDef warn fill:#FAEEDA,stroke:#854F0B,color:#412402;
