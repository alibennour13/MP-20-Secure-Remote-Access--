# Test run outputs — these are DATA, not code. Keep the folder (.gitkeep)
# but never commit actual run results here; retrieve them from the Jetson
# and archive separately (or commit deliberately per milestone if desired).
runs/*
!runs/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# OS junk
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
